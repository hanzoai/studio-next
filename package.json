{
  "name": "@hanzo/studio",
  "version": "2.0.0",
  "private": true,
  "description": "Hanzo Studio - Universal AI workflow editor (React + @hanzo/gui)",
  "license": "GPL-3.0-only",
  "homepage": "https://studio.hanzo.ai",
  "repository": "https://github.com/hanzoai/studio",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@studio/web",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "~5.7.3"
  }
}
